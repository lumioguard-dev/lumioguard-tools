{
  "name": "@lumioguard/leakpeek-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Leakpeek report client. React + Vite, served from Cloudflare Pages.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler pages deploy dist --project-name=lumioguard-leakpeek-web --branch=main",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lumioguard/design-tokens": "workspace:*",
    "@lumioguard/shared": "workspace:*",
    "@lumioguard/ui": "workspace:*",
    "@lumioguard/web-core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.9",
    "wrangler": "^3.95.0"
  }
}
