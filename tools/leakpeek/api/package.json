{
  "name": "@lumioguard/leakpeek-api",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "Leakpeek scan API: the read-only probe runner and the clock. Cloudflare Worker.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node ../../../scripts/dev-worker.mjs leakpeek",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "node ../../../scripts/deploy-worker.mjs leakpeek",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lumioguard/api-core": "workspace:*",
    "@lumioguard/leakpeek-core": "workspace:*",
    "@lumioguard/shared": "workspace:*",
    "hono": "~4.13.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.42.0"
  }
}
