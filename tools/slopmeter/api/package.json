{
  "name": "@lumioguard/slopmeter-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Slopmeter scan API: fetching, screenshots and the clock. Cloudflare Worker.",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node ../../../scripts/dev-worker.mjs slopmeter",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lumioguard/api-core": "workspace:*",
    "@lumioguard/shared": "workspace:*",
    "@lumioguard/slopmeter-core": "workspace:*",
    "hono": "^4.12.27",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9",
    "wrangler": "^3.95.0"
  }
}
